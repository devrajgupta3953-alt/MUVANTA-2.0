# SUPABASE_URL: Your Supabase project URL (e.g. https://xxxx.supabase.co)
# Configure this in the Secrets panel in AI Studio.
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL

# SUPABASE_PUBLIC_KEY: Your Supabase publishable key (e.g. sb_publishable_...)
# Configure this in the Secrets panel in AI Studio.
SUPABASE_PUBLIC_KEY=YOUR_SUPABASE_PUBLIC_KEY

# SUPABASE_ANON_KEY: Optional legacy Supabase anon key if used instead of SUPABASE_PUBLIC_KEY.
# Configure this in the Secrets panel in AI Studio.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
