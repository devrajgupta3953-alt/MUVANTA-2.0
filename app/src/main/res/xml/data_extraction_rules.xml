<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Never extract session credentials or private local Room databases to cloud backups or other devices -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
