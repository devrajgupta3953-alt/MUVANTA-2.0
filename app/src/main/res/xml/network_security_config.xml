<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Block all cleartext HTTP traffic across API 24+ and trust only system CAs -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
